generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // directUrl = env("DIRECT_URL")
}

model User {
  id                  String   @id @default(uuid())
  name                String
  email               String   @unique @db.VarChar(255)
  password            String
  role                UserRole
  hasCompletedProfile Boolean  @default(false)
  metadata            Json?

  mentor   Mentor?
  employee Employee?
  student  Student?

  createdAt DateTime  @default(now())
  sessions  Session[]

  @@index([email])
}

enum UserRole {
  companyAdmin
  collegeAdmin
  mentor
  employee
  student
}

model College {
  id      String  @id @default(uuid())
  name    String  @unique
  address String
  email   String  @unique
  phone   String?

  mentors  Mentor[]
  students Student[]
  jobs     Job[]
  collabs  Collab[]

  @@index([name])
}

model Company {
  id               String        @id @default(uuid())
  name             String        @unique
  registrationNo   String        @unique
  address          String
  email            String        @unique
  contactNo        String
  status           CompanyStatus @default(active)
  collabNameShowUp Boolean       @default(false)

  employees Employee[]
  jobs      Job[]
  collabs   Collab[]

  @@index([name])
  @@index([registrationNo])
}

enum CompanyStatus {
  active
  inactive
}

model Mentor {
  id        String @id @default(uuid())
  userId    String @unique
  collegeId String

  user    User    @relation(fields: [userId], references: [id])
  college College @relation(fields: [collegeId], references: [id])

  approvals Application[]
  jobs      Job[]

  @@index([collegeId])
}

model Employee {
  id        String @id @default(uuid())
  userId    String @unique
  companyId String

  user    User    @relation(fields: [userId], references: [id])
  company Company @relation(fields: [companyId], references: [id])

  interviews Interview[]
  feedbacks  Feedback[]

  @@index([companyId])
}

model Student {
  id        String  @id @default(uuid())
  userId    String  @unique
  collegeId String
  year      Int
  branch    String
  rollNo    String
  resume    String?
  aboutMe   String?

  user    User    @relation(fields: [userId], references: [id])
  college College @relation(fields: [collegeId], references: [id])

  skills       StudentSkill[]
  applications Application[]
  interviews   Interview[]
  feedbacks    Feedback[]
  certificates Certificate[]

  @@index([collegeId])
  @@index([branch])
}

model Skill {
  id   String @id @default(uuid())
  name String @unique

  studentSkills StudentSkill[]
  jobSkills     JobSkill[]

  @@index([name])
}

model StudentSkill {
  studentId String
  skillId   String

  student Student @relation(fields: [studentId], references: [id])
  skill   Skill   @relation(fields: [skillId], references: [id])

  @@id([studentId, skillId])
  @@index([skillId])
}

model JobSkill {
  jobId   String
  skillId String

  job   Job   @relation(fields: [jobId], references: [id])
  skill Skill @relation(fields: [skillId], references: [id])

  @@id([jobId, skillId])
  @@index([skillId])
}

model Job {
  id         String    @id @default(uuid())
  title      String
  salary     Int?
  tenure     String?
  address    String?
  status     JobStatus @default(active)
  dueDate    DateTime?
  collegeId  String
  companyId  String
  isApproved Boolean   @default(false)
  createdAt  DateTime  @default(now())
  mentorId   String?
  jobHash     String?

  mentor  Mentor?  @relation(fields: [mentorId], references: [id])
  company Company  @relation(fields: [companyId], references: [id])
  college College? @relation(fields: [collegeId], references: [id])

  applications Application[]
  jobSkills    JobSkill[]
  aptitudeTest AptitudeTest?

  @@unique([companyId, collegeId, jobHash])
  @@index([companyId])
  @@index([collegeId])
}

enum JobStatus {
  active
  closed
}

model Application {
  id             String            @id @default(uuid())
  studentId      String
  jobId          String
  mentorId       String?
  status         ApplicationStatus @default(pending)
  mentorApproval ApprovalStatus    @default(pending)

  appliedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id])
  job     Job     @relation(fields: [jobId], references: [id])
  mentor  Mentor? @relation(fields: [mentorId], references: [id])

  interview       Interview?
  certificates    Certificate[]
  aptitudeAttempt AptitudeAttempt?

  @@index([studentId])
  @@index([jobId])
  @@index([status])
  @@unique([studentId, jobId])
}

enum ApprovalStatus {
  pending
  approved
  rejected
}

// pending     -> waiting (mentor review first, then company review)
// shortlisted -> company liked the profile
// aptitude    -> aptitude test assigned / in progress / waiting for company
// interview   -> interview scheduled
enum ApplicationStatus {
  pending
  shortlisted
  aptitude
  interview
  hired
  rejected
}

model Interview {
  id                String          @id @default(uuid())
  applicationId     String          @unique
  studentId         String
  employeeId        String?
  scheduledByUserId String
  startsAt          DateTime
  endsAt            DateTime
  timeZone          String          @default("Asia/Kolkata")
  mode              InterviewMode   @default(online)
  meetLink          String?
  address           String?
  calendarEventId   String?
  calendarOwnerId   String?
  notes             String?
  status            InterviewStatus @default(scheduled)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  student     Student     @relation(fields: [studentId], references: [id])
  employee    Employee?   @relation(fields: [employeeId], references: [id])
  application Application @relation(fields: [applicationId], references: [id])

  @@index([employeeId])
  @@index([studentId])
  @@index([startsAt])
}

enum InterviewMode {
  online
  offline
}

enum InterviewStatus {
  scheduled
  completed
  cancelled
}

model Certificate {
  id            String   @id @default(uuid())
  studentId     String
  applicationId String
  fileUrl       String
  issuedAt      DateTime @default(now())

  student     Student     @relation(fields: [studentId], references: [id])
  application Application @relation(fields: [applicationId], references: [id])

  @@unique([studentId, applicationId]) // one certificate per internship
  @@index([studentId])
  @@index([applicationId])
}

model Feedback {
  id         String @id @default(uuid())
  employeeId String
  studentId  String
  feedback   String

  employee Employee @relation(fields: [employeeId], references: [id])
  student  Student  @relation(fields: [studentId], references: [id])

  @@index([employeeId])
  @@index([studentId])
}

model Collab {
  id          String          @id @default(uuid())
  collegeId   String
  companyId   String
  status      CollabStatus    @default(pending)
  initiatedBy CollabInitiator @default(company)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  college College @relation(fields: [collegeId], references: [id])
  company Company @relation(fields: [companyId], references: [id])

  @@unique([collegeId, companyId]) // Prevent duplicate collaborations
}

enum CollabInitiator {
  company
  college
}

enum CollabStatus {
  pending
  accepted
  rejected
}

model Session {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String?
  userAgent        String?
  ip               String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
}

model IdempotencyKey {
  id          String   @id @default(uuid())
  key         String   @unique
  userId      String
  endpoint    String
  response    Json
  createdAt   DateTime @default(now())
}


/* ======================= GOOGLE CALENDAR / MEET ======================= */
model GoogleCredential {
  id           String   @id @default(uuid())
  userId       String   @unique
  googleEmail  String
  refreshToken String // AES-256-GCM encrypted
  scope        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/* ======================= APTITUDE PLATFORM ======================= */
model AptitudeTest {
  id               String    @id @default(uuid())
  jobId            String    @unique
  companyId        String
  title            String
  instructions     String?
  durationMins     Int       @default(30)
  passingPercent   Int       @default(50)
  negativeMarking  Float     @default(0) // fraction of marks cut per wrong answer, e.g. 0.25
  autoRejectOnFail Boolean   @default(false)
  opensAt          DateTime?
  closesAt         DateTime?
  isPublished      Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  job       Job                @relation(fields: [jobId], references: [id])
  questions AptitudeQuestion[]
  attempts  AptitudeAttempt[]

  @@index([companyId])
}

model AptitudeQuestion {
  id           String  @id @default(uuid())
  testId       String
  text         String
  options      Json // string[]
  correctIndex Int
  marks        Int     @default(1)
  section      String? // Quant / Logical / Verbal ...
  order        Int     @default(0)

  test AptitudeTest @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@index([testId])
}

enum AttemptStatus {
  in_progress
  submitted
  expired
}

model AptitudeAttempt {
  id            String        @id @default(uuid())
  testId        String
  applicationId String        @unique
  studentId     String
  status        AttemptStatus @default(in_progress)
  startedAt     DateTime      @default(now())
  expiresAt     DateTime
  submittedAt   DateTime?
  answers       Json? // { [questionId]: optionIndex }
  score         Float?
  totalMarks    Int?
  percent       Float?
  passed        Boolean?
  tabSwitches   Int           @default(0)

  test        AptitudeTest @relation(fields: [testId], references: [id])
  application Application  @relation(fields: [applicationId], references: [id])

  @@index([testId])
  @@index([studentId])
  @@index([status, expiresAt])
}
